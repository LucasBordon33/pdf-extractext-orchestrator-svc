def make_settings(**overrides):
    defaults = {
        "http_retries": 3,
        "http_retry_backoff": 0.5,
        "http_timeout": 5.0,
        "max_upload_size": 10 * 1024 * 1024,
        "validator_service_url": "http://validator:8001",
        "extractor_service_url": "http://extractor:8002",
        "store_service_url": "http://store:8003",
    }
    defaults.update(overrides)
    return Settings(_env_file=None, **defaults)


class FakeValidator:
    def __init__(self, result=None, error=None):
        self.result = {"valid": True} if result is None else result
        self.error = error
        self.calls = []

    async def validate(self, file_bytes, filename):
        self.calls.append((file_bytes, filename))
        if self.error is not None:
            raise self.error
        return self.result


class FakeExtractor:
    def __init__(self, result=None, error=None):
        self.result = {"text": "texto extraido"} if result is None else result
