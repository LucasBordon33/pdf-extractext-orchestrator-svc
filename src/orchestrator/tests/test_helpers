class FakeStore:
    def __init__(self, result=None, error=None):
        self.result = {"id": "abc123"} if result is None else result
        self.error = error
        self.calls = []

    async def store(self, name, text, checksum):
        self.calls.append((name, text, checksum))
        if self.error is not None:
            raise self.error
        return self.result