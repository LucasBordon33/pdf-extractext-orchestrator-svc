# --- Arranque y observabilidad ---
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Cliente HTTP hacia los microservicios internos (ISSUE-008) ---
HTTP_TIMEOUT=30.0
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF=0.5

# --- L??mite de subida en bytes (10 MiB) ---
MAX_UPLOAD_SIZE=10485760

# --- URLs base de los microservicios internos ---
# Est??ticas: se usan como FALLBACK si Consul no est?? disponible.
VALIDATOR_SERVICE_URL=http://validator:8001
EXTRACTOR_SERVICE_URL=http://extractor:8002
STORE_SERVICE_URL=http://store:8003

# --- Service Discovery (Consul) ---
SERVICE_DISCOVERY_ENABLED=true
CONSUL_HOST=consul
CONSUL_PORT=8500
SERVICE_NAME=orchestrator
SERVICE_ID=
SERVICE_HOST=
SERVICE_ADDRESS_MODE=ip
SERVICE_PORT=8000
SERVICE_HEALTH_PATH=/health
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
DEREGISTER_CRITICAL_AFTER=60s
CONSUL_REGISTER_RETRIES=1
CONSUL_REGISTER_BACKOFF=0.5
DISCOVERY_CACHE_TTL=5.0
CONSUL_TIMEOUT=2.0
